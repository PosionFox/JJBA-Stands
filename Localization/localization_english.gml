#region stand abilities

tr_add(_map, "barrageDesc", "barrage:\nlaunches a barrage of punches.");
tr_add(_map, "strongPunchDesc", "strong punch:\ncharges and launches a strong punch.");

#region part 3

// stw
tr_add(_map, "uryDesc", "uryyy:\nlunge forward striking enemies on the way.");
tr_add(_map, "srseDesc", "space ripper stingy eyes:\nfire two piercing lasers at high speeds.");
tr_add(_map, "divineBloodDesc", "divine blood:\ndrains the target's health and heals the user.");
tr_add(_map, "charismaDesc", "charisma:\nrelease vampiric spores that chase enemies around.");
tr_add(_map, "xxiDesc", "xxi:\nexecutes a combo of two punches and a strong final punch.");
tr_add(_map, "punishmentDesc", "punishment:\ncharges an attack that upon impact surrounds the enemy with knives.");
tr_add(_map, "throwingKnifesDesc", "throwing knives:\nthrows two bursts of knives.");
tr_add(_map, "stwTimestopDesc", @"the world's secret power:
stops the time for a brief moment,
most enemies are not allowed to move
and makes your projectiles freeze in place.

(hold) the world:
with enough experience,
shadow the world evolves into the world.");

// sc
tr_add(_map, "scBarrageDesc", "stab barrage:\nlaunches a barrage of thursts.");
tr_add(_map, "scLungeDesc", "lunge:\nleaps forward with a strong stab.");
tr_add(_map, "scSweepDesc", "sweep:\nslashes forward with a raking attack.");
tr_add(_map, "ftlDesc", @"faster than light:
silver chariot removes its armor, providing high attack speed
and shorter cooldowns.");

// hg
tr_add(_map, "emeraldSplashDesc", "emerald splash:\nshoots out a short barrage of emeralds forward.");
tr_add(_map, "hierophantBarrierDesc", "hierophant barrier:\ncreates a barrier around the user\ndeals damage on contact.");
tr_add(_map, "emeraldSplash20MetersDesc", "20 meter emerald splash:\nshoots out a powerful barrage of emeralds forward.");

// sp
tr_add(_map, "diosKnifeDesc", "dio's knife:\ntoss one of dio's knife.");
tr_add(_map, "spStrongPunchDesc", @"strong punch:
charges and launches a strong punch.

(hold) melee pull:
pulls the enemy towards you.");
tr_add(_map, "starFingerDesc", "star finger:\nstar platinum stretches their finger hitting enemies in the way.");
tr_add(_map, "spTimestopDesc", @"time stop:
stops the time, most enemies are not allowed to move
and makes your projectiles freeze in place.

(hold) star platinum: the world:
with enough experience,
star platinum evolves into star platinum: the world.");

// tw
tr_add(_map, "josephKnifeDesc", "joseph knife:\nsend out a knife that causes bleed on impact.");
tr_add(_map, "stopSignDesc", "stop sign:\nstrike with a stop sign.");
tr_add(_map, "bloodDrainDesc", "blood drain:\ndrain the target's health and heals the user.");
tr_add(_map, "donut_punch_desc", "donut punch:\nthe stand looms forward and strikes with a piercing blow.");
tr_add(_map, "knifeWallDesc", "knife wall:\nsends out a wall of knives.");
tr_add(_map, "twTimestopDesc", "time, stop!:\nstops the time, most enemies are not allowed to move\nand makes your projectiles freeze in place.");

#endregion

#region part 4

// sptw
tr_add(_map, "sodaDesc", "soda:\ndrink from a fresh can of soda.");
tr_add(_map, "bearingShotDesc", "bearing shot:\ntoss a projectile forward.");
tr_add(_map, "tsTpDesc", "time stop teleport:\nteleport where you cursor is at.");
tr_add(_map, "sptwTimestopDesc", "star platinum the world:\nstops the time, most enemies are not allowed to move\nand makes your projectiles freeze in place.");


// kq
tr_add(_map, "detonateBombDesc", "detonate bomb:\nexplodes any bombs already placed.");
tr_add(_map, "placeBombDesc", "killer queen's first bomb:\nplaces a bomb on the nearest enemy or ground.");
tr_add(_map, "coinBombDesc", "coin bomb:\ntosses a coin that can be detonated on demand.");
tr_add(_map, "shaSummonDesc", "killer queen's second bomb:\nsummons sheer heart attack in combat,\nchasing and exploding enemies on it's own.");

// kqbtd
tr_add(_map, "theWealthyDesc", "the wealthy:\ntosses three coins forward, these can be detonated on demand.");
tr_add(_map, "strayCatDesc", "stray cat:\nreleases an explosive bubble that can be controlled.");
tr_add(_map, "thirdBombDesc", @"killer queen's third bomb:
places a special bomb on the ground.

(after cast) bites the dust:
detonates the special bomb damaging all enemies nearby,
returns the user to the original position
where they placed the bomb in the first place while also
healing the user for the amount of damage lost afterwards.
");

#endregion

#region part 5

// ge
tr_add(_map, "lifeformPlantDesc", "lifeform plant:\nsummons a random plant.");
tr_add(_map, "lifeformScorpionDesc", "lifeform scorpion:\nsummons a scorpion that attacks nearby enemies.");
tr_add(_map, "lifeformFrogDesc", "lifeform frog:\nsummons a frog that protects you and reflects damage.");
tr_add(_map, "lifePunchDesc", "life punch:\npunches the enemy and pulls their soul out,\nthe soul damages other enemies.");
tr_add(_map, "selfHealDesc", "self heal:\nmends the user's wounds,\nthe effectiveness of the healing is tied to the user's level.");

// ger
tr_add(_map, "requiemDesc", "requiem:\nawaken your stand.");
tr_add(_map, "gerBarrageDesc", "null barrage:\nlaunches a destructive barrage of punches.");
tr_add(_map, "scorpionTossDesc", "scorpion toss:\ntosses a rock foward which\ntransforms into a scorpion on impact.");

// kc
tr_add(_map, "scalpelSlashDesc", "scalpel slash:\ncarve your enemies and make them bleed.");
tr_add(_map, "scalpelThrowDesc", "scalpel throw:\nthrow two scalpels forward.");
tr_add(_map, "kcBarrageDesc", @"skip barrage:
skips time into the nearest enemy
releasing a series of fatal blows.");
tr_add(_map, "chopDesc", @"chop:
chops the enemy for moderate damage.

(hold) heavy chop:
winds up a terrible strike that is bound to
seriously harm even the toughest opponent.");
tr_add(_map, "timeSkipDesc", "time skip:\nskips time forward into a new position in space.");
tr_add(_map, "timeEraseDesc", "time erase:\nerases a frame of time, nobody will know what happened.");

// sf
tr_add(_map, "sfBarrageDesc", "sticky barrage:\nlaunches a barrage of punches.\ninflicts damaging zippers on the enemy.");
tr_add(_map, "zipperPunchDesc", "zipper punch:\ncharges and launches a strong punch.\ninflicts damaging zippers on the enemy.");
tr_add(_map, "zipperGrabDesc", "zipper grab:\ndisjoints and launches their arm forwards\ngrabbing and pulling the first enemy it touches.");
tr_add(_map, "portalThroughDesc", "portal through:\nopens two portals, one below the user\nand the other where they are aiming at.");

#endregion

#region part 6

// ws
tr_add(_map, "suddenStrikeDesc", "sudden strike:\nlaunch a surpise attack.");
tr_add(_map, "explosiveSurpriseDesc", "explosive surprise:\ntoss an explosive disc forward.");
tr_add(_map, "discProduceDesc", "disc produce:\nwhitesnake produces a new blank disc.");
tr_add(_map, "meltYourHeartDesc", "melt your heart:\nrelease an illusory pool of acid.");
tr_add(_map, "wsBarrageDesc", "acidic barrage:\nlaunches a ranged barrage of acidic punches.");
tr_add(_map, "quickDisposalDesc", "quick disposal:\nunloads a volley of bullets forward.");
tr_add(_map, "acidicSpitDesc", "acidic spit:\nspits a projectile forwards that deals damage over time.");
tr_add(_map, "discStealDesc", "disc steal:\nsteals your target's memory disc rendering them useless.");

#endregion

#region part 7

// d4c
tr_add(_map, "revolverReloadDesc", "revolver reload:\nreload your revolver.");
tr_add(_map, "bulletVolleyDesc", "bullet volley:\nfire a volley of three projectiles.");
tr_add(_map, "cloneSwapDesc", "clone swap:\nswap places with the nearest clone you aim at.");
tr_add(_map, "doubleSlapDesc", "double slap:\nhovers forward and slaps the enemies twice,\nthe second slap deals more damage.");
tr_add(_map, "clonesDesc", @"clone bomb:
summons a clone of the enemy you aim at that
chases the target and explodes on contact.

(hold) clone summon:
summons clones of the user to aid them in combat,
the amount of clones to summon depends
on the user's level.");
tr_add(_map, "dimensionalHopDesc", @"dimensional hop:
pulls out the flag and waves it
flattening the user and warping them
into another parallel dimension,
enemies in range will also be teleported.");

// d4clt
tr_add(_map, "trickShotDesc", @"trick shot:
fire a projectile forwards.

(after cast) bullet time:
redirects the projectile into the nearest enemy.");
tr_add(_map, "slashingStrikesDesc", @"slashing strikes:
launches a short barrage of strikes that inflict bleeding.

(hold) melee pull:
pulls the enemy towards you.");
tr_add(_map, "loveTrainDesc", @"love train:
summons a pocket dimension as a wall of light that
reflects all incoming damage back to the nearest enemy.

(hold) dimensional hop:
pulls out the flag and waves it
flattening the user and warping them
into another parallel dimension,
enemies in range will also be teleported.");

// twau
tr_add(_map, "tripleKnifeDesc", "triple knife:\ntoss three knives at once.");
tr_add(_map, "knifeBarrageDesc", "knife barrage:\nlaunches a barrage of knives.");
tr_add(_map, "twauTimestopDesc", @"it's my time!:
stops the time, most enemies are not allowed to move
and makes your projectiles freeze in place.

(low health) panic time stop:
the user starts to panic due to low health
and performs a longer time stop.");

#endregion

#region part 8

// snw
tr_add(_map, "moisturePlunderDesc", "moisture plunder:\ncreate a barrier of bubble around you\nthe bubbles damage enemies that touch them.");
tr_add(_map, "shovelDesc", "shovel:\npull out a shovel and whack them with it!.");
tr_add(_map, "bubbleShieldDesc", "bubble shield:\ncreate a bubble shield that protects\nyou from any damage.");
tr_add(_map, "bubbleBarrageDesc", "bubble barrage:\nlaunches a barrage of bubble forward.");
tr_add(_map, "screwsAndNutsDesc", "screws and nuts:\nlaunches a bubble filled with screws and nuts\nthat explodes on contact.");
tr_add(_map, "bubbleTrapDesc", "bubble trap:\nlaunches a bubble that traps the enemies on impact.");

#endregion

#region other

// twoh
tr_add(_map, "realityHealDesc", "reality heal:\nreverses your injuries to a previous state.");
tr_add(_map, "twohBarrageDesc", @"celestial barrage:
launches a barrage of celestial punches.

(hold) thunderous wave:
release an explosive wave forward.");
tr_add(_map, "meleeComboDesc", @"melee combo:
launches a flurry of strikes.

(hold) reality overwrite punch:
winds up a heavy blow that does
percentage damage.");
tr_add(_map, "lightningKnifesDesc", @"lightning knives:
tosses three knives forward that
shock the enemies struck.

(hold) knife buryal:
surround the nearest enemy to your cursor
with deadly knives.");
tr_add(_map, "twohTimestopDesc", @"celestial time stop:
stops the time, most enemies are not allowed to move
and makes your projectiles freeze in place,
stop and resume at will.");

// sus
tr_add(_map, "knifesDesc", @"knifes:
tosses a few knifes.");
tr_add(_map, "meetingCallDesc", @"meeting call:
presses a button that damages enemies.");
tr_add(_map, "killDesc", @"kill:
teleports to a nearby enemy and heavily damages them.");

#endregion

